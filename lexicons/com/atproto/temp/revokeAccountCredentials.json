{
  "lexicon": 1,
  "id": "com.atproto.temp.revokeAccountCredentials",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke credentials for an account. Temporary admin endpoint used by Ozone moderation actions.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["account"],
          "properties": {
            "account": {
              "type": "string",
              "format": "did",
              "description": "DID of the account whose credentials should be revoked."
            }
          }
        }
      }
    }
  }
}
