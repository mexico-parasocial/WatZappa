{
  "lexicon": 1,
  "id": "com.para.community.acceptDraftInvite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Accept a creator-authorized invitation to a draft community. Native implementations sign only the caller's membership; the creator signs the founder list and final activation.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["communityUri"],
          "properties": {
            "communityUri": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status", "memberCount"],
          "properties": {
            "status": {
              "type": "string"
            },
            "memberCount": {
              "type": "integer"
            },
            "requiresCreatorFinalization": {
              "type": "boolean",
              "description": "The accepted quorum is complete and the creator must sign activation."
            }
          }
        }
      }
    }
  }
}
