{
  "lexicon": 1,
  "id": "com.para.community.request",
  "defs": {
    "main": {
      "type": "record",
      "description": "A person's intent to take one community action, in their own repo (OD-9 §6). The community's event for the action references it; a host cannot act for a person without one. Each request backs at most one event.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "community",
          "action",
          "subject",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "community": {
            "type": "string",
            "format": "did"
          },
          "action": {
            "type": "string",
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "format": "did"
          },
          "offer": {
            "type": "integer",
            "minimum": 1
          },
          "suspensionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime",
            "description": "The event must be created before this, and at most a day after createdAt."
          },
          "sanction": {
            "type": "string",
            "knownValues": ["remove", "block"]
          },
          "target": {
            "type": "string",
            "format": "at-uri"
          },
          "targetCid": {
            "type": "string",
            "format": "cid"
          },
          "profile": {
            "type": "ref",
            "ref": "com.para.community.profile#update"
          }
        }
      }
    }
  }
}
