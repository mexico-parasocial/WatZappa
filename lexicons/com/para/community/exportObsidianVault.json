{
  "lexicon": 1,
  "id": "com.para.community.exportObsidianVault",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "community": {"type": "string", "format": "at-uri"},
          "briefingPack": {"type": "string", "format": "at-uri"},
          "collection": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["generatedAt", "files"],
          "properties": {
            "generatedAt": {"type": "string", "format": "datetime"},
            "files": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.para.community.defs#obsidianFileView" }
            }
          }
        }
      }
    }
  }
}
