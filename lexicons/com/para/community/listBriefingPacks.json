{
  "lexicon": 1,
  "id": "com.para.community.listBriefingPacks",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "community": {"type": "string", "format": "at-uri"},
          "party": {"type": "string"},
          "cabildeo": {"type": "string", "format": "at-uri"},
          "civicTreeCard": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["draft", "published", "archived"]
          },
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packs"],
          "properties": {
            "packs": {
              "type": "array",
              "items": { "type": "ref", "ref": "com.para.community.defs#briefingPackView" }
            },
            "cursor": {"type": "string"}
          }
        }
      }
    }
  }
}
