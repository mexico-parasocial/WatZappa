          "sourceCard",
          "targetCard",
          "relationshipType",
          "authorDid",
          "createdAt"
        ],
        "properties": {
          "communityUri": {
            "type": "string",
            "format": "at-uri"
          },
          "sourceCard": {
            "type": "string",
            "format": "at-uri"
          },
          "targetCard": {
            "type": "string",
            "format": "at-uri"
          },
          "relationshipType": {
            "type": "string",
            "maxLength": 64
          },
          "authorDid": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
