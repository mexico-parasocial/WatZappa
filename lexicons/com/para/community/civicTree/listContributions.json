{
  "lexicon": 1,
  "id": "com.para.community.civicTree.listContributions",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "community"
        ],
        "properties": {
          "community": {
            "type": "string",
            "format": "at-uri"
          },
          "status": {
            "type": "string",
            "knownValues": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "viewer": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "contributions"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "contributions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.para.community.civicTree.defs#contributionView"
              }
            }
          }
        }
      }
    }
  }
}
