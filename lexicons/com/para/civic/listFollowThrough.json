{
  "lexicon": 1,
  "id": "com.para.civic.listFollowThrough",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lists the compromisos of resolved cabildeos. Only records by a steward of the cabildeo's community are served, and only for a cabildeo of kind activity that resolved with a single winning option and met its quorum. Anything else yields nothing, so an empty list does not mean the cabildeo was ignored.",
      "parameters": {
        "type": "params",
        "properties": {
          "cabildeo": {
            "type": "string",
            "format": "at-uri"
          },
          "community": {
            "type": "string",
            "format": "at-uri",
            "description": "Board URI. Omit to list across all communities."
          },
          "status": {
            "type": "string",
            "knownValues": [
              "planned",
              "in_progress",
              "completed",
              "blocked",
              "abandoned"
            ]
          },
          "overdue": {
            "type": "boolean",
            "description": "Only compromisos past their due date and not completed or abandoned."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Cabildeos per page. The compromisos of one cabildeo are never split across pages."
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "summaries"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#followThroughView"
              }
            },
            "summaries": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#summaryView"
              },
              "description": "One per cabildeo that appears in items."
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    },
    "followThroughView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "cabildeo",
        "communityUri",
        "optionIndex",
        "title",
        "status",
        "overdue",
        "rescheduledCount",
        "edited",
        "createdAt"
      ],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string" },
        "author": { "type": "string", "format": "did" },
        "cabildeo": { "type": "string", "format": "at-uri" },
        "communityUri": { "type": "string", "format": "at-uri" },
        "optionIndex": { "type": "integer" },
        "parent": { "type": "string", "format": "at-uri" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "responsibleDid": { "type": "string", "format": "did" },
        "responsibleLabel": { "type": "string" },
        "dueAt": {
          "type": "string",
          "format": "datetime",
          "description": "The committed first due date."
        },
        "currentDueAt": {
          "type": "string",
          "format": "datetime",
          "description": "The latest due date, after any reschedules."
        },
        "rescheduledCount": { "type": "integer" },
        "status": {
          "type": "string",
          "knownValues": [
            "planned",
            "in_progress",
            "completed",
            "blocked",
            "abandoned"
          ],
          "description": "For an item with children, derived from them."
        },
        "progress": {
          "type": "integer",
          "description": "Absent when it cannot be determined from what was written."
        },
        "overdue": { "type": "boolean" },
        "lastUpdateAt": { "type": "string", "format": "datetime" },
        "edited": {
          "type": "boolean",
          "description": "The record was changed after it was first indexed. The committed version is what is shown."
        },
        "withdrawnUpdates": {
          "type": "integer",
          "description": "Updates that were written and later deleted."
        },
        "children": {
          "type": "array",
          "items": { "type": "ref", "ref": "#followThroughView" }
        },
        "updates": {
          "type": "array",
          "items": { "type": "ref", "ref": "#updateView" },
          "description": "Oldest first. Present on getFollowThrough only."
        },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "updateView": {
      "type": "object",
      "required": [
        "uri",
        "author",
        "status",
        "evidenceUris",
        "edited",
        "occurredAt",
        "createdAt"
      ],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "author": { "type": "string", "format": "did" },
        "status": { "type": "string" },
        "progress": { "type": "integer" },
        "note": { "type": "string" },
        "evidenceUris": { "type": "array", "items": { "type": "string" } },
        "dueAt": { "type": "string", "format": "datetime" },
        "edited": { "type": "boolean" },
        "occurredAt": { "type": "string", "format": "datetime" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "summaryView": {
      "type": "object",
      "required": ["cabildeo", "total", "completed", "overdue", "abandoned"],
      "properties": {
        "cabildeo": { "type": "string", "format": "at-uri" },
        "total": { "type": "integer", "description": "Top-level compromisos." },
        "completed": { "type": "integer" },
        "overdue": { "type": "integer" },
        "abandoned": { "type": "integer" },
        "progress": {
          "type": "integer",
          "description": "Absent unless every active compromiso has a determinable progress."
        },
        "nextDueAt": { "type": "string", "format": "datetime" },
        "lastUpdateAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
