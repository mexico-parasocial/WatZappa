{
  "lexicon": 1,
  "id": "com.para.civic.getFollowThrough",
  "defs": {
    "main": {
      "type": "query",
      "description": "One compromiso with its children and its full timeline. Not found when it is not served under the rules of com.para.civic.listFollowThrough.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["item"],
          "properties": {
            "item": {
              "type": "ref",
              "ref": "com.para.civic.listFollowThrough#followThroughView"
            }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
