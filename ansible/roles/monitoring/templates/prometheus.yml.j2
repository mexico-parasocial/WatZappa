# PARA Prometheus scrape configuration.
#
# QUARTER_PLAN_2026Q4 S1: "nothing scrapes the bridge's Prometheus metrics and
# Synapse metrics are disabled today." The previous monitoring role deployed
# node-exporter and cAdvisor with no Prometheus anywhere, so every metric they
# produced was discarded. This is the missing half.

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    host: "{{ inventory_hostname }}"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]

  # The bridge serves prom-client metrics at /metrics
  # (services/matrix-bridge/src/routes/router.ts). This is the endpoint S1
  # identified as unscraped.
  - job_name: matrix-bridge
    static_configs:
      - targets: ["matrix-bridge:3001"]

  # Synapse is NOT scraped, and adding a job for it here would only produce a
  # target that can never resolve. Two things are missing, both required:
  #
  #   1. Synapse does not join the `{{ edge_network_name }}` network. In
  #      docker-compose.matrix.yaml, matrix-bridge is the only service that
  #      does — every other Matrix service sits on that stack's default
  #      network, where Prometheus cannot reach it by name.
  #   2. `enable_metrics` is off in the homeserver config.
  #
  # To enable: add `{{ edge_network_name }}` to the synapse service's networks,
  # set enable_metrics: true in deploy/matrix/hardening.yaml, and uncomment:
  #
  # - job_name: synapse
  #   metrics_path: /_synapse/metrics
  #   static_configs:
  #     - targets: ["synapse:8008"]
