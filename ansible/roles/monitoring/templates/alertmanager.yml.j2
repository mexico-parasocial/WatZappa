# PARA Alertmanager. Receivers are chosen in group_vars (alertmanager_*); with
# none set, `para-ops` has no integrations and alerts go nowhere — the role
# warns about that rather than pretending someone is paged.
route:
  receiver: para-ops
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: para-ops
{% if alertmanager_email_to and alertmanager_smtp_smarthost %}
    email_configs:
      - to: "{{ alertmanager_email_to }}"
        from: "{{ alertmanager_email_from }}"
        smarthost: "{{ alertmanager_smtp_smarthost }}"
        auth_username: "{{ alertmanager_smtp_username }}"
        auth_password: "{{ alertmanager_smtp_password }}"
        require_tls: true
        send_resolved: true
{% endif %}
{% if alertmanager_telegram_bot_token and alertmanager_telegram_chat_id | int != 0 %}
    telegram_configs:
      - bot_token: "{{ alertmanager_telegram_bot_token }}"
        chat_id: {{ alertmanager_telegram_chat_id | int }}
        parse_mode: ""
        send_resolved: true
{% endif %}
{% if alertmanager_slack_webhook_url %}
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook_url }}"
        send_resolved: true
        title: '{{ "{{" }} .CommonLabels.alertname {{ "}}" }}'
        text: '{{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} .Annotations.summary {{ "}}" }} — {{ "{{" }} .Annotations.description {{ "}}" }}{{ "{{" }} "\n" {{ "}}" }}{{ "{{" }} end {{ "}}" }}'
{% endif %}
