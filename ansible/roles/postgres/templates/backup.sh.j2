#!/bin/bash
set -euo pipefail

# PARA database backups — all three databases.
#
# Runs daily via systemd timer (para-postgres-backup.timer).
#
# Every database is dumped THROUGH DOCKER, not over TCP. None of the Postgres
# containers publish 5432 to the host: the app Postgres uses `expose:` in
# docker-compose.prod.yaml, and the Matrix databases bind nothing at all. The
# previous version of this script ran `pg_dump -h localhost -p 5432`, which
# cannot reach any of them — backups would have failed every night.

DEPLOY_DIR="{{ para_deploy_dir }}"
BACKUP_DIR="{{ postgres_backup_dir }}"
RETENTION_DAYS="{{ postgres_backup_retention_days }}"
PG_USER="{{ postgres_user }}"

S3_ENDPOINT="{{ s3_endpoint }}"
S3_BUCKET="{{ s3_backup_bucket }}"
S3_ACCESS_KEY="{{ s3_access_key | default('') }}"
S3_SECRET_KEY="{{ s3_secret_key | default('') }}"
S3_REGION="{{ s3_region }}"

DATE=$(date +%Y%m%d_%H%M%S)
LOG="$BACKUP_DIR/backup_${DATE}.log"
mkdir -p "$BACKUP_DIR"

log() { echo "[$(date -Is)] $*" | tee -a "$LOG"; }

cd "$DEPLOY_DIR"

# service | compose file | database
#
# `mas` is listed because MAS schema migrations are ONE-WAY: a version bump
# that goes wrong cannot be rolled back without this dump. That is not a
# theoretical risk — it is why the 0.20 to 1.24 upgrade took backups first.
TARGETS=(
  "postgres|{{ app_compose_file }}|{{ postgres_db }}"
  "synapse-db|{{ matrix_compose_file }}|matrix"
  "mas-db|{{ matrix_compose_file }}|mas"
)

FAILED=0

for target in "${TARGETS[@]}"; do
  IFS='|' read -r service compose db <<< "$target"
  out="$BACKUP_DIR/${db}_${DATE}.sql.gz"

  if ! docker compose -f "$compose" ps --services --filter status=running \
       | grep -qx "$service"; then
    log "SKIP $db — service $service is not running"
    continue
  fi

  log "Dumping $db from $service ..."
  if docker compose -f "$compose" exec -T "$service" \
       pg_dump -U "$PG_USER" --no-owner --no-acl "$db" | gzip > "$out"; then

    # A pg_dump that fails mid-stream still leaves a valid gzip of a truncated
    # dump. Verify the archive rather than trusting the exit code alone.
    if gzip -t "$out" && [ "$(stat -c%s "$out")" -gt 1024 ]; then
      log "OK   $db -> $out ($(du -h "$out" | cut -f1))"
    else
      log "FAIL $db — dump is empty or corrupt"
      FAILED=1
    fi
  else
    log "FAIL $db — pg_dump returned non-zero"
    FAILED=1
  fi
done

# Off-site copy.
if [ -n "$S3_ENDPOINT" ]; then
  log "Uploading to $S3_BUCKET ..."
  export AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY"
  export AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY"
  export AWS_DEFAULT_REGION="$S3_REGION"
  for f in "$BACKUP_DIR"/*_"${DATE}".sql.gz; do
    [ -e "$f" ] || continue
    aws s3 cp "$f" "s3://$S3_BUCKET/postgres/$(basename "$f")" \
      --endpoint-url "$S3_ENDPOINT" >> "$LOG" 2>&1 \
      || { log "FAIL upload $(basename "$f")"; FAILED=1; }
  done
else
  log "WARNING: s3_endpoint is not set. These backups exist ONLY on this host."
  log "         A disk failure loses the database and the backup together."
fi

# Retention applies to local copies only; lifecycle rules on the bucket govern
# the off-site ones.
find "$BACKUP_DIR" -name '*.sql.gz' -mtime "+$RETENTION_DAYS" -delete
find "$BACKUP_DIR" -name 'backup_*.log' -mtime "+$RETENTION_DAYS" -delete

if [ "$FAILED" -ne 0 ]; then
  log "BACKUP RUN FAILED — see above"
  exit 1
fi

log "All backups completed"
