# PARA Matrix Homeserver — Caddy additions
# Append these blocks to /etc/caddy/Caddyfile (or your main Caddyfile)
# and replace matrix.para.social / chat.para.social with your real domains.

# ─────────────────────────────────────────────────────────────────────────────
# Synapse / Continuwuity homeserver
# ─────────────────────────────────────────────────────────────────────────────
matrix.para.social {
	# Serve well-known files for federation discovery
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{ "m.server": "matrix.para.social:443" }`
	}

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{ "m.homeserver": { "base_url": "https://matrix.para.social" } }`
	}

	# MAS compatibility layer: legacy login/logout/refresh endpoints must be
	# handled by MAS, not Synapse, when auth is delegated
	# (docs/setup/homeserver.md in matrix-authentication-service).
	handle /_matrix/client/v1/login {
		reverse_proxy 127.0.0.1:8080
	}
	handle /_matrix/client/v3/login {
		reverse_proxy 127.0.0.1:8080
	}
	handle /_matrix/client/v1/logout* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /_matrix/client/v3/logout* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /_matrix/client/v1/refresh {
		reverse_proxy 127.0.0.1:8080
	}

	# Reverse proxy to Synapse (port 8008)
	reverse_proxy 127.0.0.1:8008

	# PARA-only mode: no public federation listener is exposed.
}

# ─────────────────────────────────────────────────────────────────────────────
# Element Web client
# ─────────────────────────────────────────────────────────────────────────────
chat.para.social {
	# Element Web listens on 8082; 8080 belongs to MAS.
	reverse_proxy 127.0.0.1:8082
}
