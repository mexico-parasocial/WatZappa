# PARA Matrix — Caddy blocks for a host-run Caddy (deploy/bare-metal)
#
# The containerised edge (docker-compose.prod.yaml) uses the same routes in
# services/caddy/Caddyfile.prod, addressed by container name. Keep the two in
# step. Append these blocks to /etc/caddy/Caddyfile and replace para.social
# with your domain. MATRIX_MAS_PUBLIC_URL / MATRIX_IDP_PUBLIC_URL in .env must
# name the auth. and idp. hosts below before running setup-mas.sh.

# ─────────────────────────────────────────────────────────────────────────────
# Synapse — client API only. Federation is closed (hardening.yaml), so there is
# no /.well-known/matrix/server and no federation or key path. Admin,
# MAS-internal and metrics APIs never leave the host.
# ─────────────────────────────────────────────────────────────────────────────
matrix.para.social {
	encode gzip

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"https://matrix.para.social"}}`
	}

	@private path /_synapse/admin /_synapse/admin/* /_synapse/mas /_synapse/mas/* /_synapse/metrics /_synapse/metrics/* /_matrix/federation/* /_matrix/key/*
	handle @private {
		respond 404
	}

	# MAS compatibility layer: legacy login/logout/refresh belong to MAS when
	# authentication is delegated.
	@mas_compat path_regexp ^/_matrix/client/[^/]+/(login|logout|refresh)(/.*)?$
	handle @mas_compat {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		reverse_proxy 127.0.0.1:8008
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# MAS — issuer clients open to sign in. Its admin listener (8081) is not proxied.
# ─────────────────────────────────────────────────────────────────────────────
auth.para.social {
	reverse_proxy 127.0.0.1:8080
}

# ─────────────────────────────────────────────────────────────────────────────
# para-idp — browser-facing authorization only; MAS reaches /token and
# /jwks.json over the Compose network.
# ─────────────────────────────────────────────────────────────────────────────
idp.para.social {
	handle /authorize* {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		respond 404
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# Element Web — moderators' Matrix client (8080 belongs to MAS)
# ─────────────────────────────────────────────────────────────────────────────
chat.para.social {
	reverse_proxy 127.0.0.1:8082
}
