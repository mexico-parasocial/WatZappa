# PARA Production Caddyfile
#
# Hostnames come from the PARA_DOMAIN environment variable, passed to the Caddy
# container by docker-compose.prod.yaml. They were hardcoded to para-g0v.app,
# which no longer resolves — Caddy would request Let's Encrypt certificates for
# a domain with no DNS and every hostname would serve a TLS error.
#
# Set PARA_DOMAIN in the stack .env (e.g. PARA_DOMAIN=para.social).
# Place this at /etc/caddy/Caddyfile on your edge server (Computer A).
# For single-machine deploys, mount it via docker-compose.prod.yaml.
#
# Bluesky official PDS ships with Caddy in its compose.
# This config follows the same pattern: automatic HTTPS, simple routing.
#
# NOTE: Rate limiting is handled at the application level (PDS already has
# PDS_RATE_LIMITS_ENABLED=true). For additional edge protection, consider
# fail2ban or a Cloudflare/AWS WAF in front of Caddy.

# ---------------------------------------------------------------------------
# PDS — Personal Data Server (auth, repos, writes)
# ---------------------------------------------------------------------------
pds.{$PARA_DOMAIN} {
	encode gzip

	# Blob reads are immutable once written; allow clients/CDN to cache them.
	handle /xrpc/com.atproto.sync.getBlob* {
		reverse_proxy pds:2583 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy pds:2583
	}

	header {
		# Security headers
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# AppView — Feeds, search, hydration, Civic Map
# ---------------------------------------------------------------------------
appview.{$PARA_DOMAIN} {
	encode gzip

	# Image server thumbnails are expensive to generate; cache aggressively.
	handle /img/* {
		reverse_proxy bsky:2584 {
			header_down Cache-Control "public, max-age=86400"
		}
	}

	handle {
		reverse_proxy bsky:2584
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Ozone — Moderation (staff-only)
# ---------------------------------------------------------------------------
ozone.{$PARA_DOMAIN} {
	encode gzip
	reverse_proxy ozone:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Matrix bridge — community chat/governance API for the PARA app
# ---------------------------------------------------------------------------
bridge.{$PARA_DOMAIN} {
	encode gzip

	# SSE: disable proxy buffering so events flush immediately.
	handle /api/events {
		reverse_proxy matrix-bridge:3001 {
			flush_interval -1
		}
	}

	# Prometheus scrapes matrix-bridge:3001/metrics over para-edge; the
	# unauthenticated counters are not for the public.
	handle /metrics {
		respond 404
	}

	reverse_proxy matrix-bridge:3001

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Matrix homeserver — client API only (docker-compose.matrix.yaml)
#
# Federation is closed (deploy/matrix/hardening.yaml), so there is no
# /.well-known/matrix/server and no federation or key path. Synapse's admin,
# MAS-internal and metrics APIs are reached only over the Compose networks by
# the bridge, MAS and Prometheus; they never leave the host.
# ---------------------------------------------------------------------------
matrix.{$PARA_DOMAIN} {
	encode gzip

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"https://matrix.{$PARA_DOMAIN}"}}`
	}

	@private path /_synapse/admin /_synapse/admin/* /_synapse/mas /_synapse/mas/* /_synapse/metrics /_synapse/metrics/* /_matrix/federation/* /_matrix/key/*
	handle @private {
		respond 404
	}

	# Authentication is delegated to MAS: the legacy login, logout and refresh
	# endpoints belong to its compatibility layer, not to Synapse.
	@mas_compat path_regexp ^/_matrix/client/[^/]+/(login|logout|refresh)(/.*)?$
	handle @mas_compat {
		reverse_proxy mas:8080
	}

	handle {
		reverse_proxy synapse:8008
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Matrix Authentication Service — the issuer clients open to sign in
# (MATRIX_MAS_PUBLIC_URL). Its admin API is on a separate, unproxied listener.
# ---------------------------------------------------------------------------
auth.{$PARA_DOMAIN} {
	encode gzip
	reverse_proxy mas:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# para-idp — browser-facing authorization only (MATRIX_IDP_PUBLIC_URL). MAS
# fetches /token and /jwks.json over the Compose network.
# ---------------------------------------------------------------------------
idp.{$PARA_DOMAIN} {
	encode gzip

	handle /authorize* {
		reverse_proxy para-idp:8090
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

# ---------------------------------------------------------------------------
# Element Web — moderators' Matrix client
# ---------------------------------------------------------------------------
chat.{$PARA_DOMAIN} {
	encode gzip
	reverse_proxy element-web:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Well-known endpoints (AT Protocol discovery)
# These MUST be available at the domain root for federation.
# ---------------------------------------------------------------------------
{$PARA_DOMAIN} {
	encode gzip

	# Serve .well-known/atproto-did for handle resolution
	handle /.well-known/* {
		reverse_proxy pds:2583
	}

	# Fallback for everything else on the bare domain.
	#
	# This used to be `redir https://para.social/app`, written when the site
	# address was para-g0v.app so the two hosts differed. Now that PARA_DOMAIN
	# is para.social, that same redirect would point the domain at itself and
	# loop. Serve a 404 and let whoever owns the marketing page opt in.
	handle {
		respond "Not Found" 404
	}
}
