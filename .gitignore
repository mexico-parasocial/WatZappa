services/matrix-bridge/dist

# Generated SeaweedFS S3 gateway config (from .env credentials)
.seaweedfs/

# Generated Synapse config (from deploy/matrix/setup.sh). Contains the
# homeserver signing key, macaroon/form secrets and the DB password.
# The tracked hardening overlay is deploy/matrix/hardening.yaml, not this.
deploy/matrix/synapse/

# Generated lexicon schema outputs (from `lex build`)
packages/*/src/lexicons/

# Generated MAS config (from deploy/matrix/setup-mas.sh). Contains the OIDC
# signing key, the MAS encryption key, and the client secrets shared with
# Synapse and para-idp.
deploy/matrix/mas/

# Matrix backups. Each archive contains the homeserver signing key and every
# message in plaintext — as sensitive as the server itself. Never commit one,
# and encrypt before copying anywhere off the host (deploy/matrix/backup.sh).
backups/
*.tar.gz.age
